# Copy the names below into Vercel → Project → Settings → Environment Variables.
# Never commit real values.
# All keys are read ONLY on the server (api/*.js via process.env).
# Never put them in index.html or any client-side file, and never prefix with NEXT_PUBLIC_/VITE_.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFY_EMAIL=
